{
  "version": 3,
  "name": "MiniMax H3 Image to Video",
  "sections": [
    {
      "id": "lora_loaders",
      "title": "LoRA loaders",
      "order": 3,
      "default_open": true
    },
    {
      "id": "advanced_settings",
      "title": "Advanced Settings",
      "order": 4,
      "default_open": false
    }
  ],
  "nodes": {
    "124": {
      "widgets": {
        "steps": {
          "label": "Steps",
          "value_type": "int",
          "control": "slider",
          "slider_display": "number",
          "min": 1,
          "max": 60,
          "step": 1,
          "default": 20,
          "group_id": "video_generation",
          "group_title": "Video Generation",
          "group_order": 3
        }
      }
    },
    "129": {
      "widgets": {
        "noise_seed": {
          "label": "Noise seed",
          "control_after_generate": true,
          "value_type": "int",
          "group_id": "video_generation",
          "group_title": "Video Generation",
          "group_order": 2
        }
      }
    },
    "136": {
      "widgets": {
        "length": {
          "label": "Length",
          "value_type": "int",
          "control": "slider",
          "slider_display": "number",
          "min": 22,
          "max": 600,
          "step": 17,
          "default": 124,
          "display_unit": {
            "scale": 0.041666666666666664,
            "unit": "s",
            "precision": 1
          },
          "group_id": "video_generation",
          "group_title": "Video Generation",
          "group_order": 1
        }
      }
    },
    "141": {
      "present": {
        "label": "Start frame",
        "group_id": "frames",
        "group_title": "Frames",
        "group_order": 0,
        "required": false,
        "input_type": "image",
        "param": "image",
        "class_type": "vloMemoryLoadImage"
      }
    },
    "142": {
      "present": {
        "label": "End frame",
        "group_id": "frames",
        "group_title": "Frames",
        "group_order": 1,
        "required": false,
        "input_type": "image",
        "param": "image",
        "class_type": "vloMemoryLoadImage"
      }
    },
    "145": {
      "widgets": {
        "value": {
          "label": "Width",
          "value_type": "int",
          "hidden": true
        }
      }
    },
    "146": {
      "widgets": {
        "value": {
          "label": "Height",
          "value_type": "int",
          "hidden": true
        }
      }
    },
    "150": {
      "widgets": {
        "lora_name": {
          "label": "Model",
          "discover_when_bypassed": true,
          "default_node_bypass": true,
          "section_id": "lora_loaders",
          "group_id": "lora_model",
          "group_title": "Model LoRA"
        }
      }
    },
    "151": {
      "widgets": {
        "attention": {
          "label": "Attention backend",
          "section_id": "advanced_settings",
          "group_id": "model_patches",
          "group_title": "Model",
          "group_order": 0
        }
      }
    }
  },
  "frontend_controls": {
    "spectrum_enabled": {
      "label": "MiniMax Spectrum",
      "value_type": "boolean",
      "default": true,
      "section_id": "advanced_settings",
      "group_id": "model_patches",
      "group_title": "Model",
      "group_order": 1
    }
  },
  "validation": {
    "inputs": [
      {
        "kind": "optional",
        "input": "141"
      },
      {
        "kind": "optional",
        "input": "142"
      }
    ]
  },
  "derived_widgets": [],
  "rewrites": [
    {
      "when": {
        "kind": "input_presence",
        "inputs": ["141"],
        "match": "all_missing"
      },
      "bypass": ["141", "143"]
    },
    {
      "when": {
        "kind": "input_presence",
        "inputs": ["142"],
        "match": "all_missing"
      },
      "bypass": ["142", "144"]
    },
    {
      "when": {
        "kind": "compare",
        "ref": {
          "kind": "frontend_control",
          "control_id": "spectrum_enabled"
        },
        "operator": "eq",
        "value": false
      },
      "bypass": ["148"]
    }
  ],
  "slots": {},
  "pipeline": [
    {
      "id": "aspect_ratio",
      "kind": "aspect_ratio",
      "enabled": true,
      "config": {
        "stride": 32,
        "search_steps": 2,
        "resolution_ladder": { "min": 240, "max": 720, "steps": 5 },
        "postprocess": {
          "enabled": true,
          "mode": "stretch_exact",
          "apply_to": "all_visual_outputs"
        }
      },
      "targets": [
        {
          "width": {
            "node_id": "145",
            "param": "value"
          },
          "height": {
            "node_id": "146",
            "param": "value"
          }
        }
      ],
      "controls": [
        {
          "key": "target_resolution",
          "label": "Resolution",
          "value_type": "int",
          "expose": "widget",
          "default": 720,
          "group_id": "video_generation",
          "group_title": "Video Generation",
          "group_order": 0
        },
        {
          "key": "target_aspect_ratio",
          "value_type": "string",
          "group_id": "video_generation",
          "group_title": "Video Generation",
          "group_order": 0,
          "label": "Aspect ratio",
          "expose": "widget",
          "source": "client"
        }
      ]
    }
  ]
}
