{
  "version": 3,
  "name": "MiniMax H3 inpaint and stitch",
  "sections": [
    { "id": "advanced_settings", "title": "Advanced Settings", "order": 4, "default_open": false }
  ],

  "nodes": {
    "53": {
      "present": {
        "label": "Source video",
        "input_type": "video",
        "param": "file",
        "class_type": "vloMemoryLoadVideo"
      },
      "selection": {
        "export_fps": 24,
        "frame_step": 17,
        "frame_offset": 5,
        "max_frames": 719
      }
    },
    "1": {},

    "48": {
      "present": {
        "label": "First frame",
        "group_id": "frames",
        "group_title": "Frames",
        "group_order": 0,
        "required": false,
        "input_type": "image",
        "param": "image",
        "class_type": "vloMemoryLoadImage"
      }
    },
    "49": {
      "present": {
        "label": "Last frame",
        "group_id": "frames",
        "group_title": "Frames",
        "group_order": 1,
        "required": false,
        "input_type": "image",
        "param": "image",
        "class_type": "vloMemoryLoadImage"
      }
    },

    "43": {
      "widgets": {
        "noise_seed": {
          "label": "Noise seed",
          "control_after_generate": true,
          "value_type": "int",
          "group_id": "video_generation",
          "group_title": "Video Generation",
          "group_order": 2
        }
      }
    },
    "37": {
      "widgets": {
        "steps": {
          "label": "Steps",
          "value_type": "int",
          "control": "slider",
          "slider_display": "number",
          "min": 1,
          "max": 60,
          "step": 1,
          "default": 20,
          "group_id": "video_generation",
          "group_title": "Video Generation",
          "group_order": 1
        },
        "scheduler": {
          "label": "Scheduler",
          "section_id": "advanced_settings",
          "group_id": "sampling",
          "group_title": "Sampling",
          "group_order": 1
        }
      }
    },
    "36": {
      "widgets": {
        "sampler_name": {
          "label": "Sampler",
          "section_id": "advanced_settings",
          "group_id": "sampling",
          "group_title": "Sampling",
          "group_order": 0
        }
      }
    },
    "47": {
      "widgets": {
        "attention": {
          "label": "Attention backend",
          "section_id": "advanced_settings",
          "group_id": "model_patches",
          "group_title": "Model",
          "group_order": 0
        }
      }
    },

    "29": {
      "widgets": {
        "switch": {
          "label": "Blank the masked area first",
          "value_type": "boolean",
          "default": true,
          "group_id": "retake",
          "group_title": "Retake",
          "group_order": 1
        }
      }
    },
    "28": {
      "widgets": {
        "switch": {
          "label": "Bypass video retake",
          "value_type": "boolean",
          "default": false,
          "hidden": true
        }
      }
    },
    "27": {
      "widgets": {
        "switch": {
          "label": "Bypass audio retake",
          "value_type": "boolean",
          "default": false,
          "hidden": true
        }
      }
    }
  },

  "frontend_controls": {
    "spectrum_enabled": {
      "label": "MiniMax Spectrum",
      "value_type": "boolean",
      "default": true,
      "section_id": "advanced_settings",
      "group_id": "model_patches",
      "group_title": "Model",
      "group_order": 1
    }
  },

  "validation": {
    "inputs": [
      { "kind": "required", "input": "53", "message": "A source video is required." },
      { "kind": "required", "input": "33:prompt", "message": "A prompt is required." },
      { "kind": "optional", "input": "48" },
      { "kind": "optional", "input": "49" }
    ]
  },

  "derived_widgets": [
    {
      "id": "retake_mode",
      "kind": "video_audio_retake",
      "label": "Retake",
      "group_id": "retake",
      "group_title": "Retake",
      "group_order": 0,
      "default": "Video & Audio",
      "video_bypass": { "node_id": "28", "param": "switch" },
      "audio_bypass": { "node_id": "27", "param": "switch" }
    }
  ],

  "rewrites": [
    {
      "when": { "kind": "input_presence", "inputs": ["48"], "match": "all_missing" },
      "bypass": ["48", "61"]
    },
    {
      "when": { "kind": "input_presence", "inputs": ["49"], "match": "all_missing" },
      "bypass": ["49", "62"]
    },
    {
      "when": {
        "kind": "compare",
        "ref": { "kind": "frontend_control", "control_id": "spectrum_enabled" },
        "operator": "eq",
        "value": false
      },
      "bypass": ["45"]
    }
  ],

  "slots": {},

  "pipeline": [
    {
      "id": "mask_processing",
      "kind": "mask_processing",
      "after": ["aspect_ratio"],
      "targets": [
        {
          "source": { "node_id": "53", "param": "file" },
          "mask": { "node_id": "1", "param": "file" },
          "mask_type": "binary",
          "purpose": "video"
        }
      ],
      "controls": [
        {
          "key": "crop_mode",
          "label": "Mask crop mode",
          "value_type": "enum",
          "expose": "widget",
          "options": ["crop", "full"],
          "default": "crop"
        },
        {
          "key": "crop_dilation",
          "label": "Mask crop padding",
          "value_type": "float",
          "expose": "widget",
          "control": "slider",
          "slider_display": "percent",
          "min": 0,
          "max": 0.5,
          "step": 0.01,
          "default": 0.1
        }
      ]
    },
    {
      "id": "aspect_ratio",
      "kind": "aspect_ratio",
      "enabled": true,
      "config": {
        "stride": 32,
        "search_steps": 2,
        "resolution_ladder": { "min": 240, "max": 720, "steps": 5 },
        "postprocess": {
          "enabled": true,
          "mode": "stretch_exact",
          "apply_to": "all_visual_outputs"
        }
      },
      "targets": [
        {
          "width": { "node_id": "60", "param": "resize_type.width" },
          "height": { "node_id": "60", "param": "resize_type.height" }
        }
      ],
      "controls": [
        {
          "key": "target_resolution",
          "label": "Resolution",
          "value_type": "int",
          "expose": "widget",
          "default": 720,
          "group_id": "video_generation",
          "group_title": "Video Generation",
          "group_order": 0
        },
        {
          "key": "target_aspect_ratio",
          "value_type": "string",
          "group_id": "video_generation",
          "group_title": "Video Generation",
          "group_order": 0,
          "label": "Aspect ratio",
          "expose": "widget",
          "source": "client"
        }
      ]
    }
  ]
}
