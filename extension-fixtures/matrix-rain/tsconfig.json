{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@vlo/extension-sdk": ["../../packages/extension-sdk/src/index.ts"]
    }
  },
  "include": ["frontend/src"],
  "exclude": ["frontend/src/**/__tests__/**"]
}
