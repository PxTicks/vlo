# Machine-readable catalogue for extension contract impact reporting.
# Values describe review sensitivity, not whether every file is a stable API.

# Host implementation spine.
/frontend/src/features/extensions/** extension-surface=host
/backend/services/extensions/** extension-surface=host
/backend/routers/extensions.py extension-surface=host
/backend/main.py extension-surface=adapter

# Portable V1 contracts. Keep these after broader host rules so they override.
/packages/extension-sdk/** extension-surface=public
/backend/services/extensions/__init__.py extension-surface=public

# Authoring packages and executable conformance fixtures.
/extension-template/** extension-surface=authoring
/extensions/extension-development/** extension-surface=authoring
/extension-fixtures/** extension-surface=fixture
/backend/tests/test_extension*.py extension-surface=fixture
/backend/tests/test_backend_extension_runtime.py extension-surface=fixture

# Distributed frontend adapters that dispatch or persist extension behaviour.
